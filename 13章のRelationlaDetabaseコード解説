router.get('/:id', async (req, res) => {
  const user = await User.findByPk(req.params.id,{
    attributes:['name', 'username'] ,
    include:[{
      model: Blog,
      as: 'readings', //中間DBを介して該当ユーザーが登録したBlogを呼び出す
      attributes: { exclude: ['userId', 'createdAt', 'updatedAt'] },
      //ここでuserとblogのもづきのみが必要で中間データをよびだしたが、中間データにあるidやreadも付いてくる。
      //throughは中間データをいじるものであり、attributeに必要なものを絞り込む。空欄ならなにも表示させない。
      through: {
          attributes: [] 
        }
    }]
  })
  if (user) {
    res.json(user)
  } else {
    res.status(404).end()
  }
})                   
